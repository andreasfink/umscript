PROJECT_NAME=@PROJECT_NAME@
VERSION=`cat VERSION`
PROJECT_ID=me.fink.@PROJECT_NAME@
FLEX=flex
BISON=bison


CC=@CC@

all:
	./codesign_environment.sh
	xcodebuild ${XCODESIGN}
	
unlock:

language/flex_definitions.h: language/_generated_umscript.y.h

language/_generated_umscript.l.m:	language/umscript.l language/_generated_umscript.y.h
	$(FLEX) --outfile language/_generated_umscript.l.m language/umscript.l

language/_generated_umscript.y.m:	language/umscript.y
	$(BISON)  --defines=language/_generated_umscript.y.h --output-file language/_generated_umscript.y.m language/umscript.y --warnings=none

language/_generated_umscript.y.h:	language/umscript.y
	$(BISON) --defines=language/_generated_umscript.y.h --output-file language/_generated_umscript.y.m language/umscript.y --warnings=none

	security unlock-keychain ~/Library/Keychains/login.keychain

clean:
	rm -f $(BUILD_DIR)

install:
	./codesign_environment.sh
	xcodebuild ${XCODESIGN} install

install_for_pkg: 
	./codesign_environment.sh
	xcodebuild DSTROOT="install_root" install

install_root_prepare:
	xcodebuild DSTROOT="install_root" install

pkg:	install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`"

pkg2: install_root_prepare
	./make_pkg.sh "$(PROJECT_NAME)" "$(PROJECT_ID)" install_root "`cat VERSION`" "$(PROJECT_NAME).pkg"
